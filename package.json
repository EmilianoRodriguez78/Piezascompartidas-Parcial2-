{
  "name": "backend-piezas-compartidas",
  "version": "1.0.0",
  "description": "API REST (Express + Neo4j AuraDB) para analizar piezas compartidas entre marcas de un grupo automotriz",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "seed": "node backend/config/seed.js"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "neo4j-driver": "^6.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "ignore": [
      "public/*"
    ]
  }
}
